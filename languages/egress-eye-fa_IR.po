msgid "Block"
msgstr "قطع کن"

#: src/Admin/AuditTableRenderer.php:33 src/Admin/DomainTableRenderer.php:73
msgid "Unblock"
msgstr "وصل کن"

#: src/Admin/AuditTableRenderer.php:37
msgid "No manual actions yet."
msgstr "هنوز اقدام دستی انجام نشده است."

#: src/Admin/DomainTableRenderer.php:46
msgid "Slow requests by exact host"
msgstr "درخواست‌های کند به تفکیک میزبان دقیق"

#: src/Admin/DomainTableRenderer.php:47
msgid "Slow count"
msgstr "تعداد کندها"

#: src/Admin/DomainTableRenderer.php:47
msgid "Last duration (seconds)"
msgstr "آخرین مدت (ثانیه)"

#: src/Admin/DomainTableRenderer.php:47
msgid "Mean duration (seconds)"
msgstr "میانگین مدت (ثانیه)"

#: src/Admin/DomainTableRenderer.php:47
msgid "Probable source (Guess)"
msgstr "مسئول احتمالی (حدس)"

#: src/Admin/DomainTableRenderer.php:47
msgid "Status and action"
msgstr "وضعیت و اقدام"

#: src/Admin/DomainTableRenderer.php:60
msgid "Unknown"
msgstr "نامشخص"

#: src/Admin/DomainTableRenderer.php:62
msgid "Guess"
msgstr "حدس"

#: src/Admin/DomainTableRenderer.php:63
msgid "Blocked"
msgstr "مسدود"

#: src/Admin/DomainTableRenderer.php:63
msgid "Unblocked"
msgstr "وصل"

#: src/Admin/DomainTableRenderer.php:66
msgid ""
"Blocking this site or loopback host can interrupt cron and other essential "
"tasks."
msgstr ""
"قطع میزبان این سایت یا میزبان محلی می‌تواند اجرای کرون و کارهای ضروری دیگر را "
"مختل کند."

#: src/Admin/DomainTableRenderer.php:71
msgid "I understand the risk and confirm blocking this site or loopback host."
msgstr "خطر را می‌دانم و قطع میزبان این سایت یا میزبان محلی را تأیید می‌کنم."

#: src/Admin/DomainTableRenderer.php:76
msgid "No slow requests have been recorded yet."
msgstr "هنوز درخواست کندی ثبت نشده است."

#: src/Admin/ToggleDomainAction.php:59
msgid "A valid POST request is required."
msgstr "یک درخواست POST معتبر لازم است."

#: src/Admin/ToggleDomainAction.php:66
msgid "The requested action is invalid."
msgstr "اقدام درخواستی نامعتبر است."

#: src/Http/BlockedHostGuard.php:90
msgid "This host is blocked by Egress Eye."
msgstr "این میزبان توسط Egress Eye مسدود شده است."

#: src/Persistence/SchemaManager.php:159
msgid "Egress Eye supports single-site activation only."
msgstr "Egress Eye فقط فعال‌سازی روی سایت مستقل را پشتیبانی می‌کند."

#: src/Persistence/SchemaManager.php:163
msgid "Egress Eye could not initialize its diagnostic storage."
msgstr "Egress Eye نتوانست ذخیره‌سازی تشخیصی را آماده کند."

#: src/Support/Capabilities.php:32
msgid "You are not allowed to manage Egress Eye."
msgstr "شما اجازهٔ مدیریت Egress Eye را ندارید."
